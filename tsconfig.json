{
  "compilerOptions": {
    "moduleResolution": "bundler",
    "target": "es2019",
    "module": "esnext",
    "lib": ["es2019", "dom"],
    "strict": true,
    "sourceMap": true,
    "declaration": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["jest", "node"]
  },
  "include": ["src", "test"]
}
